rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 익명 로그인(Anonymous Authentication)을 켠 사용자만 dashboardData 컬렉션을
    // 읽고 쓸 수 있도록 제한해요. Firebase 콘솔 > Firestore Database > 규칙 탭에
    // 이 내용을 붙여넣고 "게시"를 눌러주세요.
    match /dashboardData/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
